# Server
SERVER_PORT=8080
GIN_MODE=debug

# MySQL DSN: user:pwd@tcp(host:port)/dbname?...
MYSQL_DSN=root:root@tcp(127.0.0.1:3306)/nanyicrm?charset=utf8mb4&parseTime=True&loc=Local

# Redis
